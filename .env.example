##############################################
# NOTIFICATION MICROSERVICE - CONFIGURATION
##############################################

# ---------- SERVEUR ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- BASE DE DONNEES (PostgreSQL) ----------
DB_URL=jdbc:postgresql://db:5432/notifications
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=postgres
DB_PASSWORD=azerty
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=false

# ---------- REDIS (cache + rate limiting distribué) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------- CORS ----------
# Origines autorisées, séparées par des virgules (sans espace)
CORS_ORIGINS=http://localhost:3000,http://localhost:7001

# ---------- EMAIL (SMTP) ----------
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Notification Service
EMAIL_AUTH_ENABLED=true
EMAIL_START_TLS_ENABLED=true
EMAIL_TLS_ENABLED=false

# ---------- SMS (Twilio) ----------
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_FROM_NUMBER=+10000000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- PUSH (Firebase) ----------
PUSH_ENABLED=false
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# ---------- RETRY / RATE LIMITING ----------
RETRY_MAX_ATTEMPTS=3
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60

# ---------- LOGGING ----------
LOG_LEVEL=DEBUG
SQL_LOG_LEVEL=INFO


# JWT_SECRET=
# JWT_EXPIRATION=86400
# JWT_REFRESH_EXPIRATION=604800
# JWT_TOKEN_TYPE=Bearer
# ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RATE_LIMIT_WINDOW=60000

